{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    // `composite` obliga a emitir. Sin outDir, `tsc -b` deja un vite.config.js
    // junto al vite.config.ts, y Vite resuelve el .js ANTES que el .ts: la
    // config compilada acabaría tapando a la de verdad.
    "outDir": "./node_modules/.tmp/tsconfig-node"
  },
  "include": ["vite.config.ts"]
}
